  function ax_scale(Action,In1,Owner_Str,Grph_Num,HAuxAxis)
% function ax_scale(Action,In1,Owner_Str,Grph_Num,HAuxAxis)
% Simple scale support for axis. Axis must use pixel position/size.
% Dick Benson, DSP Technology

  global HAX_Scale_;
  
  %define
    Fig          = 1; 
    Print_pb     = 2;
    X_min        = 3;
    X_max        = 4;
    Y_min        = 5;
    Y_max        = 6;
    Owner_Axis   = 7; % owner axis handle (index)
    Owner_Grph   = 8;
    Aux_Axis     = 9; % auxilliary axis handle (e.g. coherence in vna)
  %end_define

  % ****************************************************
  %include
    vcol_h;   %  color definitions
  %end_include
  % **************************************************** 


  if strcmp(Action,'init')
  
      HAX_Scale_= zeros(1,Aux_Axis);
  
      % if the file vi_color.mat with startup colors exists,
      % use the colors in it rather than INIT_COLORc
      if exist('vi_color.mat') ==2
         load vi_color 
         my_color=stored_vi_colors;
      else
         my_color=INIT_COLORc;
      end; 

  
       HAX_Scale_(Owner_Axis)  = In1;             % owner axis handle
       HAX_Scale_(Owner_Grph)  = Grph_Num;        % owner graph number 
       if nargin ==5
          HAX_Scale_(Aux_Axis) = HAuxAxis;
       else
          HAX_Scale_(Aux_Axis) = [];
       end;
       ppos                  = get(In1,'pos');
       vsize                 = 120;
       ypos=ppos(2)+ppos(4)-vsize;
       my_name='Set Scale';
       HAX_Scale_(Fig)=figure('numbertitle','off','resize','off','menu','none',...
                              'visible','off',...
                              'pos',[ppos(1),ypos, 220, vsize],... 
                              'color', my_color(DLG_BKc,:),... 
                              'name',my_name,'BackingStore','off',...
                              'userdata',Owner_Str); 
       
       xlim=get(In1,'Xlim');
       ylim=get(In1,'Ylim');
      
       if beyondv4
           set(HAX_Scale_(Fig),'WindowStyle','modal');
           scbh  = 'close(gcf)';
       else 
           modal(my_name);
           scbh  = [' modal(',['''',my_name,''''],'); close(gcf); drawnow;'];
       end;
       
       uicontrol(HAX_Scale_(Fig),'style','text','str','Min              Max',...
                 'pos',[45 95 155 16],'backgroundcolor',my_color(LBL_BKc,:));
       uicontrol(HAX_Scale_(Fig),'style','text','str','Y','pos',[10 70 30 16],...
                 'backgroundcolor',my_color(LBL_BKc,:)); 
       uicontrol(HAX_Scale_(Fig),'style','text','str','X','pos',[10 45 30 16],...
                 'backgroundcolor',my_color(LBL_BKc,:));
       
       HAX_Scale_(Y_min)= uicontrol(HAX_Scale_(Fig),'style','edit','str',num2str(ylim(1)),...
                                    'pos',[45 70 75 16],'backgroundcolor',my_color(EDT_BKc,:));

       HAX_Scale_(Y_max)=uicontrol(HAX_Scale_(Fig),'style','edit','str',num2str(ylim(2)),...
                                    'pos',[125 70 75 16],'backgroundcolor',my_color(EDT_BKc,:));
               
       HAX_Scale_(X_min)= uicontrol(HAX_Scale_(Fig),'style','edit','str',num2str(xlim(1)),...
                                    'pos',[45 45 75 16],'backgroundcolor',my_color(EDT_BKc,:));

       HAX_Scale_(X_max)=uicontrol(HAX_Scale_(Fig),'style','edit','str',num2str(xlim(2)),...
                                   'pos',[125 45 75 16],'backgroundcolor',my_color(EDT_BKc,:));
      

       HAX_Scale_(Print_pb) = uicontrol(HAX_Scale_(Fig),'style','pushbutton','str','Scale',...
                                        'pos' ,[25 10  55 20],...
                                        'callback',['ax_scale(''scale'')']);
     
       uicontrol(HAX_Scale_(Fig),'style','pushbutton','str','Cancel','pos',[140 10 55 20],...
                 'callback',scbh); 

       set(HAX_Scale_(Fig),'visible','on');

  elseif strcmp(Action,'scale') 
       xmin=s2n(get(HAX_Scale_(X_min),'str'));
       xmax=s2n(get(HAX_Scale_(X_max),'str'));
       ymin=s2n(get(HAX_Scale_(Y_min),'str'));
       ymax=s2n(get(HAX_Scale_(Y_max),'str'));
      
       % check if the numbers are good ...
       s=[];
       if isempty(xmin)
          s=[' X min. Only numerical values allowed.']; 
       elseif isempty(xmax) 
          s=[' X max. Only numerical values allowed.']; 
       elseif isempty(ymin) 
          s=[' Y min. Only numerical values allowed.']; 
       elseif isempty(ymax) 
          s=[' Y max. Only numerical values allowed.']; 
       elseif (xmin>xmax) 
          s=[' X min must be < X max.']; 
       elseif (ymin>ymax) 
          s=[' Y min must be < Y max.']; 
       else
          if beyondv4
             set(HAX_Scale_(Fig),'WindowStyle','normal');
          else 
             modal(get(HAX_Scale_(Fig),'name'));  % toggle modal
          end;
       
         
          Owner_Str=get(HAX_Scale_(Fig),'userdata');
          close(HAX_Scale_(Fig));                 % close this dialog for the print
          set(HAX_Scale_(Owner_Axis),'Ylim',[ymin ymax],'Xlim',[xmin xmax]); 
          
          if length(HAX_Scale_) >= Aux_Axis
             set(HAX_Scale_(Aux_Axis),'Xlim',[xmin xmax]); 
          end;
          
          eval([Owner_Str,'(''set'',''ax_dat'',',int2str(HAX_Scale_(Owner_Grph)),');']);
          % report changes to owner for cursor area threshold update
       end;
     
       if ~isempty(s)
          s =['Input entry error ',s, ' Understand?'];
          uiyncf('Input Error',(get(gcf,'Position')),s,'  ','','');
       end;
  

     
  else % end of  print 
     disp([Action,' oops']);
  end; % main if then else construction (switchyard)
% end  function










