  function Out1=slider(Hin,Action,In1,In2,In3,In4,In5,In6,In7,In8,In9,In10)
% function Out1=slider(Hin,Action,In1,In2,In3,In4,In5,In6,In7,In8,In9,In10)   
% Integrated slider. (Other than the name, this is identical to islider.mi)
% Creates a pseudo object that has the 5 following sub objects:
%  ------label-----
%  min---value--max
%  -----slider-----
%
% Hin is the main handle submitted to the this function that was returned by the init action 
% Action
%     'init'      In1= [x,y,w] in pixels
%                 In2= [sldmin,sldmax,value,edmin,edmax] values
%                 In3= slider label, no label if In3=''
%                 In4= slider call back   
%                 In5= not used (for compatibility with older rev)
%                 In6= 'on' or 'off' (visibility)
%                 In7= mode 1=linear
%                           2=linear integers
%                           3=power of 2
%                           4=linear quantized to In7(2)
%                           5= quasi log with min step size of In7(2)
%                 In8= [[r g b];   label background color
%                       [r g b];   edit field background color
%                       [r g b];   label foreground color, [0 0 0] if not given
%                       [r g b]]   edit field foreground color, default=[0 0 0] 
%                 In9= [fmtmin fmtval fmtmax] format strings
%                      e.g['%2.1f';'%6.1f';'%5.0f']
%                 In10 = [optional], Parent figure handle (hf) added to
%                                    uicontrols, uimenus, and slider to keep objects 
%                                    in parent figure with monkey on mouse. 
%                 Out1 returns main handle of this pseudo object
%     'get'       Out1 returns the current value of the integrated slider
%     'set'
%       'minmax'    In2 [sldmin,sldmax,edmin,edmax] 
%                   In3 (optional) can have a new label
%                   In4 (optional) visibility
%                   In5 (optional) value
%                   Out1= returns a possibly limited value, do not ignore! 
%       'value'     In2 has target slider value, Out1 returns a possibly limited value, do not ignore! 
%       'vis_on'    optional 'no_label' in arg In2
%       'vis_off'
%       'ena_on'    enable
%       'ena_off'   disable
%       'label'     In2 set label string
%                   In3 (optional) visibility
%       'newquant'  In2 has a new quantization value
%       'position'  In2= [x,y,w] in pixels

% Dick Benson, DSP Technology

%include
   vsiz_h 
   vsld_h
%end_include
  
%define
  label    =1;
  slide    =2;
  mintxt   =3;
  maxtxt   =4;
  valro    =5;
  lastobj  =5;
  
  mode1    =6;
  quant    =7;
  last_h   =7;
  
  min_ed   =1;
  max_ed   =2;
%end_define

   if strcmp(Action,'init')~=1
      h = findobj('Tag','PseudoSlider','Value',Hin);
      if length(h) ~= 1 disp('Bad PseudoSlider handle'); return; end;
      h = get(h,'userdata');             % get local handles
      fmt= get(h(mintxt),'userdata');    % get formating info
   end;

   if strcmp(Action,'init')   % create and position slider objects
      h       = zeros(1,last_h);
      fmt     = In9;
      
      if nargin <=11
         hf = gcf;
      else
         hf = In10;
      end;
      
      min_str = ftoa(fmt(1,:),In2(1));
      max_str = ftoa(fmt(3,:),In2(2)); 

      if length(In8(:,1))<=2 In8=[In8;0 0 0;0 0 0]; end; 
      if strcmp(In3,'') label_vis='off'; else label_vis=In6; end

      slist = findobj('Tag','PseudoSlider'); % get list of slider text handles
      Out1 = 0;         % Out1 will be the handle of the pseudo object
      for k=slist'
          Out1 = max(Out1,get(k,'Value'));
      end;
      Out1 = Out1 + 1;  % slider object handle is 1 bigger than all others.
      h(label) =uicontrol(hf,'Style','text','visible',label_vis,...
                        'Tag','PseudoSlider','Value',Out1,...
                        'String',In3,...
                        'BackGroundColor',In8(1,:),...
                        'ForeGroundColor',In8(3,:),...
                        'HorizontalAlignment','center');
       % userdata in this label is a vector of all the handles of the
       % pseudo slider. The Value property contains the pseudo slider handle.
                                    
      h(slide) =   uicontrol(hf,'Style','slider','visible',In6,... 
                        'BackGroundColor',In8(1,:),...
                        'Min',In2(1),'Max',In2(2),'Value',max(min(In2(3),In2(2)),In2(1)),...
                        'userdata',In2(3),...
                        'Callback',sprintf('slider(%d,''CBslide'')',Out1));

      h(mintxt) =  uicontrol(hf,'Style','text','visible',In6,...
                        'String',min_str,...
                        'BackGroundColor',In8(1,:),...
                        'ForeGroundColor',In8(3,:),...
                        'userdata',fmt,...
                        'HorizontalAlignment','left');

      h(maxtxt) =  uicontrol(hf,'Style','text','visible',In6,...
                        'String',max_str,...
                        'BackGroundColor',In8(1,:),...
                        'ForeGroundColor',In8(3,:),...
                        'userdata',In4,...
                        'HorizontalAlignment','right');

      h(valro) =   uicontrol(hf,'Style','edit','visible',In6,...
                        'String',ftoa(fmt(2,:),In2(3)),...
                        'BackgroundColor',In8(2,:),... 
                        'ForeGroundColor',In8(4,:),...
                        'userdata',In2(4:5),...
                        'HorizontalAlignment','center',...
                        'Callback',sprintf('slider(%d,''CBedit'')',Out1));
      
      % store mode and optional quantization value
      h(mode1)=In7(1);
      if length(In7) >=2 h(quant)=In7(2); end;
      set(h(label),'userdata',h);
      slider(Out1,'set','position',In1);
                        

   elseif strcmp(Action,'get')
       Out1 = s2n(get(h(valro),'String'));  % v5, this could cause some problems
       % Out1 = get(h(slide),'Value');
       

   elseif strcmp(Action,'CBedit')       % call back for edit box
          % set slider position
          newval = s2n(get(h(valro),'String')); 
          if isempty(newval) 
              set(h(valro),'String',ftoa(fmt(2,:),get(h(slide),'value'))); 
          else
              if h(mode1)==LINc | h(mode1)==QUASILOGc  % no tweaking needed
              elseif h(mode1)==LININTc     % nearest integer
                 newval= round(newval);
              elseif h(mode1)==POWOF2c     % limit to 2^N
                 newval = 2 ^ nextpow2(newval/1.414);
              elseif h(mode1)==LININTQc    % quantize to value in h(quant)
                 newval=h(quant)*round(newval/h(quant));  
              else
                  disp([num2str(h(mode1)),': unsupported mode in slider.mi']);
              end;
              
              minmax=get(h(valro),'userdata');
              newval=min(newval,minmax(max_ed));
              newval=max(newval,minmax(min_ed));
              set(h(valro),'String',ftoa(fmt(2,:),newval));
              newval = max(min(get(h(slide),'max'),newval),get(h(slide),'min'));  % v5
              set(h(slide),'Value',newval,'userdata',newval);
              eval(get(h(maxtxt),'userdata'));  % invoke user callback function
          end;

   elseif strcmp(Action,'CBslide')       % call back for slider
          % sets value readout 
             newval = get(h(slide),'Value');
             % userdata has last value
             if h(mode1)==LINc 
                  % no tweak needed
             elseif h(mode1)==LININTc
                  newval= round(newval);  
                  % this simple operation does not work well for 
                  % abs(min-max) < about 50
                  % the arrows won't move the slider
                                          
             elseif h(mode1)==POWOF2c
                  % limit to 2^N
                  if newval >= get(h(slide),'userdata')-eps
                     newval=2^nextpow2(newval);
                  else
                     newval=2^nextpow2(newval/2);
                  end;
                  if newval < get(h(slide),'min')
                     newval = get(h(slide),'min');
                  end;
                  
              elseif h(mode1)==LININTQc
                  % quantize to value in h(quant)
                  newval=h(quant)*round(newval/h(quant));

              elseif h(mode1)==QUASILOGc
                  % quasi log steps
                  % see what slider mode was pushed with sldclick
                  click_type = sldclick(h(slide));
                  if (click_type ~= SAMEc) & (click_type ~= DRAGc)  
                      oldval     = get(h(slide),'userdata');
                      % h(quant) has minimum step size
                      if abs(oldval)>0 
                         offset = -1.5;
                         step  = click_type*max(10^( round(offset+log10(abs(oldval)))),h(quant));
                      else
                         step  = click_type*h(quant); 
                      end;
                      % make newval limited multiple of the step size....
                      newval = min(max(step*round((oldval+step)/step), get(h(slide),'min')),get(h(slide),'max'));
                  end;
              else
                  disp([num2str(h(mode1)),': unsupported mode in slider.mi']);
              end;
              set(h(valro),'String',ftoa(fmt(2,:),newval));
              set(h(slide),'Value',newval,'userdata',newval);
              eval(get(h(maxtxt),'userdata'));  % invoke user callback function
       
   elseif strcmp(Action,'set')
       if strcmp(In1,'value')
           % complete overhaul for v5 
           eminmax = get(h(valro),'userdata');       % get edit minmax range
           set(h(valro), 'string',ftoa(fmt(2,:),max(min(In2,eminmax(2)),eminmax(1))));   % set limited value
           Out1    = s2n(get(h(valro),'String'));    % return limited, quantized value
           set(h(slide),'value',max(min(get(h(slide),'max'),Out1),get(h(slide),'min'))); % set limited value                                      % v5
      
       elseif strcmp(In1,'newquant')
           h(quant) = In2;
           newval = h(quant)*round(get(h(slide),'Value')/h(quant));
           Out1   = newval;
           set(h(valro),'String',ftoa(fmt(2,:),newval));
           set(h(slide),'Value',newval,'userdata',newval);
           set(h(label),'userdata',h); % save updated quantization    
       
      
       elseif strcmp(In1,'minmax')   
           set(h(valro),'userdata',In2(3:4));
           set(h(mintxt),'string',ftoa(fmt(1,:),In2(1)));
           set(h(maxtxt),'string',ftoa(fmt(3,:),In2(2)));
           oldval   = s2n(get(h(valro),'String'));  % v5, this could cause some problems
           if nargin >=7
              % possibly an optional target value has been supplied
              if ~isempty(In5)
                 oldval = In5;    % v5 , set oldval to it and proceed
              end;   
           end;
           
           % limit slider value to new min/max (edit limits)
           newval=max(min(oldval,In2(4)),In2(3));   % limit to edit box min-max values
           if newval ~=oldval
              set(h(valro),'string',ftoa(fmt(2,:),newval));
           end;
           set(h(slide),'min',In2(1),'max',In2(2),'value',max(min(In2(2),newval),In2(1))); % v5 
           Out1=s2n(get(h(valro),'String'));        % v5 return limited quantized value
           
           if nargin >=5
             if ~isempty(In3)
                 set(h(label),'string',In3);
             end;    
           end;
           
           if nargin >=6
             if ~isempty(In4)
                set(h(label:lastobj),'visible',In4);
             end;   
           end;
           
       elseif strcmp(In1,'label')
           set(h(label),'string',In2);
           if nargin >=5
             set(h(label:lastobj),'visible',In3)
           end;
           
           
       elseif strcmp(In1,'vis_on')
           if nargin >3
              if strcmp(In2,'no_label') 
                 % no label
                 set(h(label),'visible','off');
                 set(h(slide:lastobj),'visible','on')
              else
                 disp('use no_label arg in slider.m');
              end;
           else
              if strcmp('',get(h(label),'string'))
                 % no label string, leave vis off
                 set(h(label),'visible','off');
                 set(h(slide:lastobj),'visible','on')
              else
                 set(h(label:lastobj),'visible','on')
              end;   
           end;
       elseif strcmp(In1,'vis_off') 
           set(h(label:lastobj),'visible','off');
           
       elseif strcmp(In1,'ena_on')     
            set(h(slide),'enable','on');
            set(h(valro),'enable','on');
       elseif strcmp(In1,'ena_off')
            set(h(slide),'enable','off');
            set(h(valro),'enable','off');

       elseif strcmp(In1,'position')
         lmin = 7*fix(s2n(fmt(1,2:(length(deblank(fmt(1,:)))-1)))) + 7;
         lmax = 7*fix(s2n(fmt(3,2:(length(deblank(fmt(3,:)))-1)))) + 7;
         lval = In2(3)-(lmin+lmax);
         a = (get(0,'screenpix')-96)/10;  % Adjustment for large fonts
         y1 = In2(2) - SSP1c - a;  h1 = HSLDc+a;
         set(h(label), 'Position',[In2(1:3) HTXTc+a/2]);
         set(h(slide), 'Position',[In2(1),In2(2)-SSP2c,In2(3),HSLDc-1-a]);
         set(h(mintxt),'Position',[In2(1),y1,lmin,h1]);
         set(h(maxtxt),'Position',[In2(1)+In2(3)-lmax,y1,lmax,h1]);
         set(h(valro), 'Position',[In2(1)+lmin,y1-1,lval,h1+2]);
       end;
   else
      disp([Action,': Action unrecognized in slider.m'])
   end;  % large if
% end function slider
